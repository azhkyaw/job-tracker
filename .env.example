# Copy to .env (gitignored) — auto-loaded by pipeline/config.py.
# Real shell env vars take precedence over these.

# Docker Postgres from docker-compose.yml (host port 55432). On WSL/Linux with
# a socket Postgres, use: postgresql:///tracker
# For a managed Postgres (e.g. Neon) so the app can run from more than one
# machine, use the DIRECT/unpooled connection string (sslmode=require) — see
# "Managed Postgres" in docs/windows-dev.md for why the pooler breaks this
# app's SET ROLE / RLS pattern.
TRACKER_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/tracker

# Signing/encryption root for sessions + stored Gmail creds. Set ONCE and keep
# (losing it orphans encrypted Gmail credentials). A dev value is fine locally.
TRACKER_SECRET_KEY=dev-secret-change-me

# Bearer token the browser extension sends to /captures. Paste the same value
# into the extension's Options page.
TRACKER_API_TOKEN=dev-extension-token

# Required for `work` / `backfill` (LLM calls).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables embeddings + duplicate detection. Absent = dedup off.
VOYAGE_API_KEY=

# Public base URL — only needed for the Gmail *web* OAuth redirect
# (<TRACKER_BASE_URL>/oauth/gmail/callback). The IMAP default and the CLI OAuth
# flow don't use it.
TRACKER_BASE_URL=http://127.0.0.1:8000

# Take EVERY message in the mailbox, skipping the sender/subject candidate
# pre-filter. Correct only for a mailbox that is job-related only — everyone
# else's inbox has their bank and their doctor in it. When true, a message
# classified not_job_related has its body purged, so the widened net doesn't
# become a widened retention footprint.
#
# Set this per machine, deliberately: it is the one flag that fails QUIETLY when
# missing. A second machine on the same database without it silently reverts to
# the pre-filter and drops job mail the other machine ingests, against the same
# rows. Leave it unset unless you mean it.
TRACKER_INGEST_ALL=false

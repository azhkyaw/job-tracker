{
  "manifest_version": 3,
  "name": "Job Tracker Capture",
  "version": "0.11.0",
  "description": "Captures job descriptions and the apply form's screening questions at the moment you apply on LinkedIn, JobStreet, and Indeed — and, from the toolbar, on any employer's job page — and sends them to your personal tracker.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Tracker"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "shared/jobposting.js",
        "adapters/linkedin.js",
        "shared/answers.js",
        "shared/capture.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.jobstreet.com/*",
        "*://*.jobstreet.com.sg/*",
        "*://*.jobstreet.com.my/*",
        "*://*.jobstreet.co.id/*",
        "*://*.seek.com.au/*"
      ],
      "js": [
        "shared/jobposting.js",
        "adapters/jobstreet.js",
        "shared/answers.js",
        "shared/capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.indeed.com/*"
      ],
      "js": [
        "shared/jobposting.js",
        "adapters/indeed.js",
        "shared/answers.js",
        "shared/capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}

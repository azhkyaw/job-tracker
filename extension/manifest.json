{
  "manifest_version": 3,
  "name": "Job Tracker Capture",
  "version": "0.15.0",
  "description": "Captures job descriptions and the apply form's screening questions at the moment you apply on LinkedIn, JobStreet, and Indeed — and, from the toolbar, on any employer's job page — and sends them to your personal tracker.",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "declarativeContent"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Tracker",
    "default_icon": {
      "16": "icons/off-16.png",
      "24": "icons/off-24.png",
      "32": "icons/off-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "shared/jobposting.js",
        "adapters/linkedin.js",
        "shared/answers.js",
        "shared/capture.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.jobstreet.com/*",
        "*://*.jobstreet.com.sg/*",
        "*://*.jobstreet.com.my/*",
        "*://*.jobstreet.co.id/*",
        "*://*.seek.com.au/*"
      ],
      "js": [
        "shared/jobposting.js",
        "adapters/jobstreet.js",
        "shared/answers.js",
        "shared/capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.indeed.com/*"
      ],
      "js": [
        "shared/jobposting.js",
        "adapters/indeed.js",
        "shared/answers.js",
        "shared/capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://jobs.lever.co/*",
        "*://jobs.ashbyhq.com/*",
        "*://apply.workable.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.successfactors.com/career*",
        "*://*.successfactors.eu/career*",
        "*://*.successfactors.com/portalcareer*",
        "*://*.successfactors.eu/portalcareer*",
        "*://jobs.smartrecruiters.com/*",
        "*://*.icims.com/*",
        "*://*.applytojob.com/*",
        "*://*.breezy.hr/*"
      ],
      "js": [
        "shared/jobposting.js",
        "adapters/generic.js",
        "shared/answers.js",
        "shared/capture.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
